define
    name sub attribute,
        value string;
    output sub attribute,
        value string;
    knowledge_id sub attribute,
        value string;
    id sub attribute,
        value string;
    parent sub attribute,
        value string;
    event sub entity,
        owns name,
        owns output,
        plays causal_path:cause,
        plays causal_path:effect,
        plays causal_model:submodel,
        plays causal_model:event,
        plays actors_list:act;    
    causal_path sub relation,
        plays causal_model:causal_path,
        relates cause,
        relates effect;
    causal_model sub relation,
        owns name,
        relates causal_path,
        relates submodel,
        relates event,
        plays causal_path:cause,
        plays causal_path:effect,
        plays causal_model:submodel;
    actors_list sub relation,
        relates act,
        relates actor;
    actor_entity sub entity,
        owns name,
        owns id,
        plays actors_list:actor,
        plays actor_relation:actor,
        plays knowledge_model:kg_entity;
    actor_relation sub relation,
        owns name, 
        owns id,
        relates actor,
        plays knowledge_model:kg_relation;
    knowledge_model sub relation,
        owns name,
        owns id,
        relates kg_entity,
        relates kg_relation,
        relates kg_attribute,
        relates kg_model,
        plays knowledge_model:kg_model;
    