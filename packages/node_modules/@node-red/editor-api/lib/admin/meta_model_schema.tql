### META MODEL SCHEMA

define

    name sub attribute,
        value string;
    output sub attribute,
        value string;
    
    event sub entity,
        owns name,
        owns output,
        plays causal_path:cause,
        plays causal_path:effect,
        plays causal_model:submodel,
        plays causal_model:event,
        plays actor_list:owner;

    kg_node sub entity,
        owns node_id,
        owns tab_id,
        plays actor_list: actor;
        
    causal_path sub relation,
        plays causal_model:causal_path,
        relates cause,
        relates effect;

    causal_model sub relation,
        owns name,
        relates causal_path,
        relates submodel,
        relates event;

    actor_list sub relation,
        relates owner,
        relates actor;


