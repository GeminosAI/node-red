define
    name sub attribute,
        value string;
    nrid sub attribute,
        value string;
    output sub attribute,
        value string;
    knowledge_id sub attribute,
        value string;
    id sub attribute,
        value string;
    timestamp sub attribute,
        value string;
    parent sub attribute,
        value string;
    ca_uuid sub attribute,
        value string;
    ca_timestamp sub attribute,
        value string;
    ca_library sub attribute,
        value string;
    ca_estimand sub attribute,
        value string;
    ca_estimand_assumption sub attribute,
        value string;
    ca_estimand_type sub attribute,
        value string;
    ca_ate sub attribute,
        value string;
    ca_realized_expr sub attribute,
        value string;
    ca_stats_pvalue sub attribute,
        value string;
    ca_stats_intercept sub attribute,
        value string;
    ca_stats_mse_model sub attribute,
        value string;
    ca_stats_mse_resid sub attribute,
        value string;
    ca_stats_mse_total sub attribute,
        value string;
    ca_stats_rsquared sub attribute,
        value string;
    ca_stats_rsquared_adj sub attribute,
        value string;
    ca_const_marginal_ate sub attribute,
        value string;
    ca_const_marginal_effect sub attribute,
        value string;
    ca_marginal_ate sub attribute,
        value string;
    ca_marginal_effect sub attribute,
        value string;
    ca_model_score sub attribute,
        value string;
    ca_ate_lowerbound sub attribute,
        value string;
    ca_ate_upperbound sub attribute,
        value string;
    ca_cate sub attribute,
        value string;
    ca_estimation_category sub attribute,
        value string;
    ca_estimation_type sub attribute,
        value string;
    ca_estimator_type sub attribute,
        value string;
    ca_estimation_method sub attribute,
        value string;
    schema sub attribute,
        value string;
    edge_strength sub attribute,
        value string;
    causal_mechanisms sub attribute,
        value string;
    intrinsic_effects sub attribute,
        value string;
    edge_dependence_test sub attribute,
        value string;
    local_markov_test sub attribute,
        value string;
    gpt_prompt sub attribute,
        value string;
    gpt_research_question sub attribute,
        value string;
    gpt_recent_results sub attribute,
        value string;
    gpt_api_key sub attribute,
        value string;
    gpt_api_org sub attribute,
        value string;
    schema_version sub attribute,
        value double;
    project sub entity,
        owns nrid @key,
        owns name,
        owns id,
        plays deployment:project,
        plays causal_model:contains,
        plays knowledge_model:contains,
        plays gpt_instance:project;
    deployment sub relation, 
        owns timestamp,
        owns schema,
        owns schema_version,
        relates causal_model,
        relates knowledge_model,
        relates project;
    causeeffect sub entity,
        owns nrid @key,
        owns name,
        owns edge_strength,
        owns intrinsic_effects,
        owns causal_mechanisms,
        owns edge_dependence_test,
        owns local_markov_test,
        owns output,
        plays causal_path:cause,
        plays causal_path:effect,
        plays causal_model:submodel,
        plays causal_model:causeeffect,
        plays causal_analysis:treatment,
        plays causal_analysis:outcome,
        plays actors_list:act;    
    causal_path sub relation,
        owns nrid @key,
        owns id,
        owns edge_strength,
        owns intrinsic_effects,
        owns causal_mechanisms,
        plays causal_model:causal_path,
        relates cause,
        relates effect;
    causal_model sub relation,
        owns nrid @key,
        owns name,
        relates causal_path,
        relates submodel,
        relates causeeffect,
        relates describes,
        relates contains,
        plays causal_path:cause,
        plays causal_path:effect,
        plays causal_model:submodel,
        plays deployment:causal_model;
    causal_analysis sub relation,
        owns ca_uuid,
        owns ca_timestamp,
        owns ca_library,
        relates treatment,
        relates outcome,
        plays causal_model:describes;
    ca_dowhy sub causal_analysis,
        owns ca_estimand,
        owns ca_estimand_assumption,
        owns ca_estimand_type,
        owns ca_ate,
        owns ca_realized_expr,
        owns ca_stats_pvalue,
        owns ca_stats_intercept,
        owns ca_stats_mse_model,
        owns ca_stats_mse_resid,
        owns ca_stats_mse_total,
        owns ca_stats_rsquared,
        owns ca_stats_rsquared_adj,
        owns ca_estimation_method;
    ca_econml sub causal_analysis,
        owns ca_ate,
        owns ca_const_marginal_ate,
        owns ca_const_marginal_effect,
        owns ca_marginal_ate,
        owns ca_marginal_effect,
        owns ca_estimation_category,
        owns ca_estimation_type,
        owns ca_estimator_type,
        owns ca_model_score;
    ca_causalml sub causal_analysis,
        owns ca_ate,
        owns ca_ate_lowerbound,
        owns ca_ate_upperbound,
        owns ca_cate,
        owns ca_estimation_category,
        owns ca_estimation_type,
        owns ca_estimator_type;
    actors_list sub relation,
        relates act,
        relates actor;
    thing_sub sub relation,
        relates parent,
        relates child;
    attribute_sub sub thing_sub;
    relation_sub sub thing_sub;
    entity_sub sub thing_sub;
    properties sub relation,
        owns name,
        owns nrid,
        relates modified,
        relates modifier;
    attribute_type sub relation,
        owns name, 
        owns id,
        relates typeof,
        plays properties:modifier,
        plays knowledge_model:km_attribute;
    km_thing sub entity,
        owns name,
        owns id,
        owns nrid @key,
        plays actors_list:actor;
    km_entity sub km_thing,
        plays properties:modified, 
        plays entity_sub:parent,
        plays entity_sub:child,
        plays km_role:subject,
        plays knowledge_model:km_entity;
    km_relation sub km_thing,
        plays properties:modified,
        plays relation_sub:parent,
        plays relation_sub:child,
        plays km_role:predicate,
        plays km_role:defines,
        plays knowledge_model:km_relation;
    km_attribute sub km_thing,
        plays attribute_sub:parent,
        plays attribute_sub:child,
        plays properties:modifier,
        plays attribute_type:typeof,
        plays knowledge_model:km_attribute;
    km_role sub relation,
        owns nrid @key,
        owns name,
        owns id,
        relates predicate,
        relates subject,
        relates defines,
        relates typeof,
        plays km_role:typeof,
        plays knowledge_model:km_role;
    knowledge_model sub relation,
        owns nrid @key,
        owns name,
        owns id,
        relates km_entity,
        relates km_relation,
        relates km_attribute,
        relates km_role,
        relates km_model,
        relates contains,
        plays deployment:knowledge_model,
        plays knowledge_model:km_model;
    gpt_info sub entity,
        owns nrid @key,
        owns gpt_prompt,
        owns gpt_research_question,
        owns gpt_api_key,
        owns gpt_api_org,
        owns gpt_recent_results,
        plays gpt_instance:gpt_info;
    gpt_instance sub relation,
        owns name @key,
        relates gpt_info,
        relates project;